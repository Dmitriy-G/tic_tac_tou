# Shared secret verified by the engine's InternalTokenFilter on every request from the session
# service (X-Internal-Token header). No default is committed anywhere in application.yml — both
# services fail fast at startup if this is unset. See docs/adr/0002-security-model.md.
INTERNAL_TOKEN=change-me-to-a-long-random-value

# Set to true when serving over HTTPS so the session-owner cookie gets the Secure attribute.
# Leave false for local/plain-HTTP docker compose runs.
SECURE_COOKIES=false
